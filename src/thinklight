#!/bin/bash
# thinklight on|off [--force]|status|blink [seconds]|check|config [key value]|mute|unmute|theme install <pkg>|current|reset|tunnel setup|status|version|update [--check]
# One light, two states: on = an agent is running, off = nothing running.
# The daemon owns the LED; this CLI only records per-session tokens and makes
# sure the daemon is available.
BIN_DIR="${THINKLIGHT_BIN_DIR:-$HOME/.local/bin}"
DAEMON="$BIN_DIR/thinklight-daemon"
# pgrep/pkill -f patterns are regexes; escape the path so `.` and friends
# match literally wherever this ends up installed.
DAEMON_RE=$(printf '%s' "$DAEMON" | sed 's/[][*^$+?(){}|\\.]/\\&/g')
# launchd job label for this install; hashing the daemon path keeps a test CLI
# (THINKLIGHT_BIN_DIR override) away from the real install's job.
DAEMON_LABEL="thinklight-$(printf '%s' "$DAEMON" | cksum | awk '{print $1}')"
STATE="${THINKLIGHT_STATE_DIR:-$HOME/.local/state/thinklight}"
SESSIONS="$STATE/sessions"
SPAWN_LOCK="$STATE/spawn.lock"
SOURCE_FILE="$STATE/source"
REVISION_FILE="$STATE/revision"
UPDATE_CHECK_FILE="$STATE/update-check"
# Written by whichever installer put the binaries here, so the version is the
# installers' to state rather than a constant this file has to remember to bump.
VERSION_FILE="$STATE/version"
VERSION_NOTICE_FILE="$STATE/version-notice"
REPO="lichengzhe/thinklight"
REPO_URL="https://github.com/$REPO.git"
# What a prebuilt install measures itself against and updates from: published
# releases rather than main, because a release is what it was installed from.
RELEASES_URL="https://github.com/$REPO/releases/latest"
GET_SH_URL="https://raw.githubusercontent.com/$REPO/main/get.sh"
# Sound lives here rather than in the state dir because the tracks are the
# user's to replace. Installers only ever write defaults/; the tracks beside it
# and the flag that switches them on belong to whoever runs `unmute`, so an
# update can neither silence a machine nor overwrite a swapped-in track.
SHARE="${THINKLIGHT_SHARE_DIR:-$HOME/.local/share/thinklight}"
SOUND_FLAG="$SHARE/sound-on"
DEFAULT_TRACKS="$SHARE/defaults"
# What AVAudioPlayer can actually decode. A theme package is checked against
# this up front, so a format it cannot play is rejected at install time rather
# than failing silently the first time the daemon tries to load it.
SOUND_EXTS="mp3 flac wav m4a aac aiff aif caf"
# Settings a user chose belong beside the tracks, out of reach of installers,
# for the same reason: an update must not be able to switch the background
# update check back on for someone who turned it off.
UPDATE_CHECK_OFF="$SHARE/update-check-off"
# Read by the plugin's SessionStart hook before this CLI necessarily exists, so
# it is a file rather than something only the CLI can answer. THINKLIGHT_NO_BOOTSTRAP
# is the same switch for a machine that has never run thinklight at all.
BOOTSTRAP_OFF="$SHARE/bootstrap-off"

# An agent on another machine reaches the light over the ssh connection you are
# already using. `thinklight tunnel setup` adds a RemoteForward that publishes the
# daemon's socket as a loopback port on the far side; `on` there finds that port
# open and sends the session to the Mac in front of you instead of lighting one
# nobody is looking at. This script is the only thing the far side needs, and on
# a machine with no tunnel every path below stays exactly as it was.
TUNNEL_PORT="${THINKLIGHT_PORT:-47823}"
SOCKET="$STATE/ipc.sock"
PROTO=thinklight1
SSH_CONFIG="${THINKLIGHT_SSH_CONFIG:-$HOME/.ssh/config}"
SSH_BLOCK_START="# >>> thinklight >>>"
SSH_BLOCK_END="# <<< thinklight <<<"

# Hooks pipe a JSON payload on stdin: session_id names the token so a
# session's on/off pair up even across apps with different environments.
PAYLOAD=""
KEY=""
OWNER_PID=""
SESSION_KEY=""
TRANSCRIPT_PATH=""
TURN_ID=""

# Banners are a macOS affordance, and this CLI also runs on the machine holding
# the agent, which may be neither a Mac nor anywhere near a screen. Nothing to
# say there is better than an error nobody sees.
notify() {
  [[ "$(uname -s)" == Darwin ]] || return 0
  /usr/bin/osascript -e "display notification \"$2\" with title \"$1\"" >/dev/null 2>&1
}

json_field() {
  printf '%s' "$PAYLOAD" | sed -n "s/.*\"$1\"[[:space:]]*:[[:space:]]*\"\([^\"]*\)\".*/\1/p" | head -n1
}

# A bare hook command is normally exec'd directly, making PPID the long-lived
# Claude/Codex process. If a shell or launcher remains in between, walk upward
# and bind the token to the first agent host instead of that short-lived wrapper.
owner_pid() {
  local pid=$PPID parent command steps=0
  while [[ "$pid" =~ ^[0-9]+$ && "$pid" -gt 1 && "$steps" -lt 12 ]]; do
    command=$(ps -o comm= -p "$pid" 2>/dev/null)
    case "${command##*/}" in
      claude|codex) echo "$pid"; return 0 ;;
    esac
    parent=$(ps -o ppid= -p "$pid" 2>/dev/null)
    parent=${parent//[[:space:]]/}
    [[ "$parent" =~ ^[0-9]+$ ]] || break
    pid=$parent
    steps=$((steps + 1))
  done
  echo "$PPID"
}

load_session_context() {
  mkdir -p "$SESSIONS" || {
    echo "thinklight: cannot create state directory: $SESSIONS" >&2
    return 1
  }
  PAYLOAD=""
  [[ -t 0 ]] || PAYLOAD=$(cat) || return 1
  OWNER_PID=$(owner_pid)
  SESSION_KEY=$(json_field session_id)
  [[ "$SESSION_KEY" =~ ^[A-Za-z0-9_-][A-Za-z0-9._-]*$ ]] || SESSION_KEY="ppid-$OWNER_PID"
  TRANSCRIPT_PATH=$(json_field transcript_path)
  TURN_ID=$(json_field turn_id)
  KEY="$SESSION_KEY"
  # Codex includes a stable turn id on turn-scoped hooks. Keeping each turn in
  # its own token lets the daemon reap an interrupted turn without racing the
  # next prompt from the same still-running session.
  if [[ "$TURN_ID" =~ ^[A-Za-z0-9_-][A-Za-z0-9._-]*$ ]]; then
    KEY="$SESSION_KEY.$TURN_ID"
  else
    TURN_ID=""
  fi
}

# Written via mktemp+mv so the daemon never reads a half-written token.
write_token() {
  local tmp
  tmp=$(mktemp "$SESSIONS/.tok.XXXXXX") || return 1
  if ! printf '%s\n%s\n%s\n%s\n' "$OWNER_PID" "$TRANSCRIPT_PATH" "$TURN_ID" "$SESSION_KEY" > "$tmp" \
    || ! mv -f "$tmp" "$SESSIONS/$KEY"; then
    rm -f "$tmp"
    return 1
  fi
}

remove_context_tokens() {
  local token
  if [[ -n "$TURN_ID" ]]; then
    # Also remove the legacy per-session token so upgrading while a turn is
    # active cannot strand the token written by the previous CLI version.
    rm -f "$SESSIONS/$KEY" "$SESSIONS/$SESSION_KEY"
    return
  fi
  # SessionEnd has no turn id. Remove the legacy per-session token plus any
  # turn-scoped Codex tokens that recorded this session key. Session ids may
  # contain dots, so the name prefix alone could also match a different
  # session named "$SESSION_KEY.something"; the recorded key disambiguates.
  rm -f "$SESSIONS/$SESSION_KEY" || return 1
  for token in "$SESSIONS/$SESSION_KEY".*; do
    [[ -f "$token" ]] || continue
    [[ "$(sed -n '4p' "$token" 2>/dev/null)" == "$SESSION_KEY" ]] || continue
    rm -f "$token" || return 1
  done
}

# The far side is named so two servers cannot land on one token, and named from
# characters the daemon will accept in a filename: it turns this into one.
tunnel_host_id() {
  local id
  id=$(hostname -s 2>/dev/null) || id=$(hostname 2>/dev/null)
  id=${id//[^A-Za-z0-9_-]/-}
  printf '%s\n' "${id:0:64}"
}

tunnel_close() {
  { exec 3>&-; } 2>/dev/null
}

# Anything at all could be listening on that port — it is an ordinary loopback
# port on a machine other people may share. Only the daemon's own greeting says
# otherwise, and waiting for it costs one round trip over an ssh connection that
# is already open, which is cheaper than a hook that mistakes some unrelated
# service for the light.
tunnel_connect() {
  local hello
  { exec 3<>"/dev/tcp/127.0.0.1/$TUNNEL_PORT"; } 2>/dev/null || return 1
  if ! IFS= read -r -t 2 hello <&3 || [[ "$hello" != "$PROTO" ]]; then
    tunnel_close
    return 1
  fi
}

tunnel_send() {
  printf '%s\t%s\t%s\t%s\t%s\n' "$PROTO" "$1" "$(tunnel_host_id)" "${2:--}" "${3:--}" >&3
}

# Holds the connection open for the length of the turn. The daemon treats it as
# the session's liveness handle — a dropped ssh, a killed agent or a closed lid
# ends the connection, and the light goes out without anyone having to guess at a
# timeout. It closes this end when `off` arrives, which is how the read below
# returns. The wakeup covers the one case the socket cannot see by itself: the
# agent on this machine exiting without ever running `off`.
tunnel_hold() {
  local line rc
  while kill -0 "$OWNER_PID" 2>/dev/null; do
    IFS= read -r -t 5 line <&3 && continue
    rc=$?
    (( rc > 128 )) || break
  done
  tunnel_close
}

tunnel_on() {
  tunnel_connect || return 1
  tunnel_send on "$KEY" "$SESSION_KEY" || { tunnel_close; return 1; }
  # Detached from the hook's stdout as well as backgrounded: a child still
  # holding that pipe open would keep the agent waiting on a hook that already
  # returned. The parent's copy of the connection goes with the parent; the
  # holder keeps its own.
  tunnel_hold </dev/null >/dev/null 2>&1 &
  disown 2>/dev/null
  tunnel_close
}

tunnel_off() {
  tunnel_connect || return 1
  tunnel_send off "$KEY" "$SESSION_KEY"
  tunnel_close
}

# `off` typed at a terminal means "light off, now", and on a machine reaching the
# light through a tunnel that has to mean the far end too.
tunnel_clear() {
  tunnel_connect || return 1
  tunnel_send clear
  tunnel_close
}

# Run by ssh out of the Match block below, once per connection it applies to, so
# it is a stat and a pgrep in the steady state. A non-zero exit is honest rather
# than convenient: it drops the RemoteForward for that connection instead of
# publishing a port that forwards to nothing.
tunnel_ensure() {
  local tries=0 budget=25
  [[ "$(uname -s)" == Darwin ]] || return 1
  [[ -S "$SOCKET" ]] && daemon_running && return 0
  if ! daemon_running; then
    ensure_daemon >/dev/null 2>&1 || return 1
    # A daemon this call just started has a camera to discover and a permission
    # to be granted before it reaches the socket, and the first ssh after a
    # reboot is exactly when that happens. Waiting seconds is worth it once;
    # waiting them on a daemon that is already up and simply has no socket — one
    # too old to listen — would be a tax on every ssh for the rest of time.
    budget=200
  fi
  while [[ ! -S "$SOCKET" ]]; do
    tries=$((tries + 1))
    (( tries < budget )) || return 1
    sleep 0.02
  done
}

ssh_block() {
  local pattern=$1
  # originalhost, not host: `host` is matched against the HostName an earlier
  # Host block resolved, which for `ssh mini` is by then an address. The name
  # you typed is the one you meant, and it is what originalhost holds.
  #
  # The path is single-quoted inside ssh's own quoting because a home directory
  # may contain spaces, and ssh hands this string to a shell verbatim.
  printf '%s\n' "$SSH_BLOCK_START" \
    "# Sends an agent's on/off back to this Mac's light. Written by: thinklight tunnel setup" \
    "Match originalhost $pattern exec \"'$BIN_DIR/thinklight' tunnel ensure\"" \
    "  RemoteForward 127.0.0.1:$TUNNEL_PORT $SOCKET" \
    "$SSH_BLOCK_END"
}

tunnel_setup() {
  local pattern tmp
  # Joined with commas because that is how one Match host line names several.
  pattern=$(IFS=,; printf '%s' "$*")
  pattern=${pattern:-*}
  [[ "$(uname -s)" == Darwin ]] || {
    echo "thinklight: run tunnel setup on the Mac with the light, not on the machine running the agent" >&2
    return 1
  }
  mkdir -p -m 700 "${SSH_CONFIG%/*}" || {
    echo "thinklight: cannot create ${SSH_CONFIG%/*}" >&2
    return 1
  }
  tmp=$(mktemp "${SSH_CONFIG%/*}/.thinklight.XXXXXX") || return 1
  # Replacing rather than appending: running setup again with a different host
  # list has to leave one block behind, not two that both forward the same port.
  if [[ -f "$SSH_CONFIG" ]]; then
    awk -v s="$SSH_BLOCK_START" -v e="$SSH_BLOCK_END" '
      $0 == s { skip = 1 }
      skip == 0 { print }
      $0 == e { skip = 0 }
    ' "$SSH_CONFIG" > "$tmp" || { rm -f "$tmp"; return 1; }
  fi
  ssh_block "$pattern" >> "$tmp" || { rm -f "$tmp"; return 1; }
  chmod 600 "$tmp" && mv -f "$tmp" "$SSH_CONFIG" || {
    rm -f "$tmp"
    echo "thinklight: could not write $SSH_CONFIG" >&2
    return 1
  }
  echo "added to $SSH_CONFIG:"
  ssh_block "$pattern" | sed 's/^/  /'
  echo
  echo "New ssh sessions to $pattern carry the light. On that machine, install the"
  echo "ThinkLight plugin — nothing else, and nothing that needs a Mac."
  # ssh drops the whole block when that command cannot be run, and it does it
  # quietly — a Match that does not match is ordinary. Better to say it here.
  [[ -x "$BIN_DIR/thinklight" ]] || {
    echo "thinklight: nothing is installed at $BIN_DIR/thinklight, so ssh will skip that block" >&2
    echo "thinklight: install the CLI there, or edit the path the block names" >&2
  }
  tunnel_ensure || echo "thinklight: the daemon here is not listening yet; run thinklight blink 1 and try again" >&2
}

ssh_block_installed() {
  [[ -f "$SSH_CONFIG" ]] && grep -qxF "$SSH_BLOCK_START" "$SSH_CONFIG"
}

tunnel_status() {
  # Reachability first: on the machine running the agent that is the whole
  # answer, and on a Mac being ssh'd into it is the answer that decides where
  # this session's light goes.
  if tunnel_connect; then
    tunnel_close
    echo "tunnel: reachable on port $TUNNEL_PORT — sessions here light the Mac at the other end"
  elif [[ "$(uname -s)" == Darwin ]]; then
    echo "tunnel: none on port $TUNNEL_PORT — sessions here light this machine"
  else
    # No tunnel and no camera: saying "this machine" would name a light that does
    # not exist. What is missing is the setup on the Mac you ssh in from.
    echo "tunnel: none on port $TUNNEL_PORT — an agent here has nowhere to report"
    echo "run thinklight tunnel setup on the Mac you ssh in from, then reconnect"
    return 0
  fi
  [[ "$(uname -s)" == Darwin ]] || return 0
  if [[ -S "$SOCKET" ]]; then
    echo "socket: $SOCKET"
  else
    echo "socket: not listening (the daemon creates it; try thinklight blink 1)"
  fi
  if ssh_block_installed; then
    echo "ssh config: configured in $SSH_CONFIG"
  else
    echo "ssh config: not configured; run thinklight tunnel setup"
  fi
}

daemon_running() {
  pgrep -qfx "$DAEMON_RE"
}

any_daemon_running() {
  daemon_running \
    || pgrep -qfx "$DAEMON_RE built-in" \
    || pgrep -qfx "$DAEMON_RE studio" \
    || pgrep -qfx "$DAEMON_RE both"
}

ensure_daemon() {
  daemon_running && return 0
  [[ -x "$DAEMON" ]] || {
    echo "thinklight: daemon is not installed: $DAEMON" >&2
    return 1
  }

  # shlock reaps locks whose recorded pid is dead, so a killed CLI cannot wedge this.
  local tries=0
  while ! /usr/bin/shlock -f "$SPAWN_LOCK" -p $$; do
    tries=$((tries + 1))
    if [[ "$tries" -ge 100 ]]; then
      echo "thinklight: timed out waiting to start the daemon" >&2
      return 1
    fi
    sleep 0.02
  done

  if ! daemon_running; then
    # Spawn through launchd so the daemon is its own TCC "responsible process".
    # Spawned straight from a hook it would inherit the hosting terminal's
    # responsibility, and macOS then blames the terminal for the camera with an
    # extra green pill in the menu bar ("Ghostty is using the camera").
    launchctl remove "$DAEMON_LABEL" 2>/dev/null
    if ! launchctl submit -l "$DAEMON_LABEL" -- "$DAEMON" 2>/dev/null; then
      nohup "$DAEMON" </dev/null >/dev/null 2>&1 &
    fi
  fi
  rm -f "$SPAWN_LOCK" || return 1

  tries=0
  while ! daemon_running; do
    tries=$((tries + 1))
    if [[ "$tries" -ge 100 ]]; then
      echo "thinklight: daemon failed to start" >&2
      return 1
    fi
    sleep 0.02
  done
}

stop_daemons() {
  local tries=0
  # remove both terminates a launchd-managed daemon and drops its job label,
  # which would otherwise outlive the process; pkill covers pre-launchd daemons.
  while any_daemon_running || launchctl list "$DAEMON_LABEL" >/dev/null 2>&1; do
    launchctl remove "$DAEMON_LABEL" 2>/dev/null
    pkill -fx "$DAEMON_RE" 2>/dev/null
    # Daemon invocations from older multi-light versions took a backend argument.
    pkill -fx "$DAEMON_RE built-in" 2>/dev/null
    pkill -fx "$DAEMON_RE studio" 2>/dev/null
    pkill -fx "$DAEMON_RE both" 2>/dev/null
    tries=$((tries + 1))
    if [[ "$tries" -ge 100 ]]; then
      echo "thinklight: daemon did not stop" >&2
      return 1
    fi
    sleep 0.02
  done
}

has_sessions() {
  local token
  [[ -d "$SESSIONS" ]] || return 1
  for token in "$SESSIONS"/*; do
    [[ -f "$token" ]] && return 0
  done
  return 1
}

clear_sessions() {
  local token
  [[ -d "$SESSIONS" ]] || return 0
  for token in "$SESSIONS"/* "$SESSIONS"/.tok.*; do
    [[ -f "$token" ]] || continue
    rm -f "$token" || return 1
  done
}

remote_revision() {
  git ls-remote "$REPO_URL" refs/heads/main 2>/dev/null | awk 'NR == 1 { print $1 }'
}

latest_release() {
  # Integration tests stand in for the network here, the way THINKLIGHT_GET_SH
  # does for the plugin's installer.
  [[ -n "${THINKLIGHT_LATEST_VERSION:-}" ]] && { printf '%s\n' "$THINKLIGHT_LATEST_VERSION"; return 0; }
  # Where the redirect lands, rather than the newest tag over ls-remote: a tag is
  # pushed before its release is built, and a check that names a version get.sh
  # cannot download yet is worse than one that waits a few minutes.
  curl -fsSLI -o /dev/null -w '%{url_effective}' "$RELEASES_URL" 2>/dev/null |
    sed -n 's#.*/releases/tag/v##p'
}

# How this install was made decides both of the questions below: what latest
# means, and what updating is. A checkout tracks main by revision; everything
# else tracks published releases by version.
installed_from_source() {
  [[ -s "$REVISION_FILE" ]]
}

version_at_least() {
  local candidate=$1 baseline=$2
  [[ "$candidate" =~ ^[0-9]+\.[0-9]+\.[0-9]+$ ]] || return 1
  [[ "$baseline" =~ ^[0-9]+\.[0-9]+\.[0-9]+$ ]] || return 1
  [[ "$(printf '%s\n%s\n' "$candidate" "$baseline" | sort -V | tail -1)" == "$candidate" ]]
}

# Prints "current VERSION" or "behind INSTALLED LATEST". Returns 1 when the
# installed version is unrecorded and 2 when GitHub cannot be reached, so a
# caller can tell the two silences apart. Both the check the user asks for and
# the unattended one route through here, and so cannot disagree.
release_status() {
  local installed remote
  installed=$(cat "$VERSION_FILE" 2>/dev/null)
  [[ -n "$installed" ]] || return 1
  remote=$(latest_release)
  [[ -n "$remote" ]] || return 2
  # Installed ahead of the newest published release is a real state rather than an
  # update: the plugin installs the release matching itself, and between a version
  # bump and its release build that version is the newer one.
  if version_at_least "$installed" "$remote"; then
    printf 'current %s\n' "$installed"
  else
    printf 'behind %s %s\n' "$installed" "$remote"
  fi
}

check_update() {
  if installed_from_source; then check_update_source; else check_update_release; fi
}

check_update_source() {
  local installed remote
  installed=$(cat "$REVISION_FILE" 2>/dev/null)
  remote=$(remote_revision)
  [[ -n "$remote" ]] || { echo "thinklight: could not check for updates" >&2; return 1; }
  if [[ "$installed" == "$remote" ]]; then
    echo "thinklight: up to date (${installed:0:7})"
  else
    echo "thinklight: update available (${installed:0:7} -> ${remote:0:7}); run: thinklight update"
  fi
}

check_update_release() {
  local status rc state installed remote
  status=$(release_status)
  rc=$?
  if (( rc )); then
    if (( rc == 2 )); then
      echo "thinklight: could not check for updates" >&2
    else
      echo "thinklight: cannot tell which version is installed; re-run the install line from the README" >&2
    fi
    return 1
  fi
  read -r state installed remote <<< "$status"
  if [[ "$state" == current ]]; then
    echo "thinklight: up to date ($installed)"
  else
    echo "thinklight: update available ($installed -> $remote); run: thinklight update"
  fi
}

schedule_update_check() {
  local now last=0
  # Only the unattended check is switchable. `thinklight update --check` is a
  # question the user just asked out loud, and answering it is not telemetry.
  [[ -f "$UPDATE_CHECK_OFF" ]] && return 0
  # Nothing to compare against unless an installer recorded one of the two things
  # it can: a checkout's revision or a release's version. Asking the network a
  # question whose answer cannot be used is worse than not asking. An install
  # the plugin keeps current answers "up to date" and stays quiet, which is
  # cheaper than leaving a get.sh install with no signal at all.
  [[ -s "$REVISION_FILE" || -s "$VERSION_FILE" ]] || return 0
  now=$(date +%s)
  [[ -f "$UPDATE_CHECK_FILE" ]] && last=$(cat "$UPDATE_CHECK_FILE" 2>/dev/null)
  [[ "$last" =~ ^[0-9]+$ ]] || last=0
  [[ $((now - last)) -ge 86400 ]] || return 0
  echo "$now" > "$UPDATE_CHECK_FILE"
  nohup "$0" _check_update_notify </dev/null >/dev/null 2>&1 &
}

perform_update() {
  if installed_from_source; then perform_update_source; else perform_update_release; fi
}

perform_update_release() {
  local installer tmp= rc
  [[ -s "$VERSION_FILE" ]] || {
    echo "thinklight: cannot tell how this was installed; re-run the install line from the README" >&2
    return 1
  }
  installer=${THINKLIGHT_GET_SH:-}
  if [[ -z "$installer" ]]; then
    tmp=$(mktemp "${TMPDIR:-/tmp}/thinklight-get.XXXXXX") || return 1
    curl -fsSL "$GET_SH_URL" -o "$tmp" || {
      rm -f "$tmp"
      echo "thinklight: could not download the installer" >&2
      return 1
    }
    installer=$tmp
  fi
  # get.sh is not reimplemented here. It is the one place that knows the layout —
  # which files go where, which of them an update must never touch, how to replace
  # a daemon that is running — so updating a prebuilt install is running it again.
  bash "$installer"
  rc=$?
  [[ -n "$tmp" ]] && rm -f "$tmp"
  return $rc
}

perform_update_source() {
  local source branch
  source=$(cat "$SOURCE_FILE" 2>/dev/null)
  [[ -n "$source" && -d "$source/.git" && -x "$source/install.sh" ]] || {
    echo "thinklight: source checkout unavailable; clone the repo and run install.sh" >&2
    return 1
  }
  branch=$(git -C "$source" branch --show-current)
  [[ "$branch" == main ]] || { echo "thinklight: refusing to update source branch '$branch' (expected main)" >&2; return 1; }
  if ! git -C "$source" diff --quiet || ! git -C "$source" diff --cached --quiet; then
    echo "thinklight: source checkout has uncommitted changes; update manually" >&2
    return 1
  fi
  git -C "$source" pull --ff-only origin main || return 1
  "$source/install.sh"
}

# Tracks are matched by stem, not by a fixed filename, so any format macOS can
# decode works: drop in loop.mp3 and it plays without touching the daemon.
track_for() {
  local stem=$1 dir=$2 track
  for track in "$dir/$stem".*; do
    [[ -f "$track" ]] || continue
    printf '%s\n' "$track"
    return 0
  done
  return 1
}

ext_allowed() {
  local ext=$1 candidate
  for candidate in $SOUND_EXTS; do
    [[ "$ext" == "$candidate" ]] && return 0
  done
  return 1
}

# No jq: theme.json's fields are single-line strings, so a sed capture on the
# `"key": "value"` shape covers every theme this format asks for. The pattern
# anchors on the quoted key, so "filename" cannot be mistaken for "name" nor
# "subtitle" for "title" — but only reads top-level fields: `.*` is greedy,
# so a nested object, or any value that itself contains `"key": "..."`, would
# make this return the last match in the file instead of the top-level one.
# Fine for the flat layout this format documents; nested metadata would need
# more than sed.
theme_field() {
  local key=$1 file=$2
  sed -n "s/.*\"$key\"[[:space:]]*:[[:space:]]*\"\([^\"]*\)\".*/\1/p" "$file" 2>/dev/null | head -n1
}

print_config() {
  local stem track theme_name
  if [[ -f "$SOUND_FLAG" ]]; then echo "sound: on"; else echo "sound: off"; fi
  echo "tracks: $SHARE"
  for stem in loop done; do
    if track=$(track_for "$stem" "$SHARE"); then
      echo "$stem track: ${track##*/}"
    else
      echo "$stem track: missing"
    fi
  done
  if [[ -f "$BOOTSTRAP_OFF" ]]; then echo "bootstrap: off"; else echo "bootstrap: on"; fi
  if [[ -f "$UPDATE_CHECK_OFF" ]]; then echo "update-check: off"; else echo "update-check: on"; fi
  # Appended last so the line numbers every earlier field already prints at
  # stay put for anything reading this output by position.
  if [[ -f "$SHARE/theme.json" ]]; then
    theme_name=$(theme_field name "$SHARE/theme.json")
    echo "theme: ${theme_name:-unknown}"
  else
    echo "theme: default"
  fi
}

# Every "off" is the same shape: a marker in the user's own directory, created
# only when it has somewhere to live.
switch_off() {
  mkdir -p "$SHARE" || {
    echo "thinklight: cannot create the settings directory: $SHARE" >&2
    return 1
  }
  : > "$1"
}

# `mute`/`unmute` stay as the shortcut for the setting people touch; this is the
# same switches by name, and the only way to reach the ones without a verb.
set_config() {
  local key=$1 value=$2
  case "$key:$value" in
    sound:on) unmute_sound; return ;;
    sound:off) mute_sound; return ;;
    bootstrap:on)
      rm -f "$BOOTSTRAP_OFF" || return 1
      ;;
    bootstrap:off)
      switch_off "$BOOTSTRAP_OFF" || return 1
      ;;
    update-check:on)
      rm -f "$UPDATE_CHECK_OFF" || return 1
      ;;
    update-check:off)
      switch_off "$UPDATE_CHECK_OFF" || return 1
      ;;
    *)
      echo "thinklight: usage: thinklight config [sound|bootstrap|update-check] [on|off]" >&2
      return 64
      ;;
  esac
  print_config
}

# Only fills empty slots: a track you replaced with your own survives every
# later unmute, and deleting one is how you go back to the bundled default.
seed_default_tracks() {
  local stem track
  for stem in loop done; do
    track_for "$stem" "$SHARE" > /dev/null && continue
    track=$(track_for "$stem" "$DEFAULT_TRACKS") || continue
    install -m 644 "$track" "$SHARE/${track##*/}" || return 1
  done
}

unmute_sound() {
  mkdir -p "$SHARE" || {
    echo "thinklight: cannot create the sound directory: $SHARE" >&2
    return 1
  }
  seed_default_tracks || return 1
  # The daemon re-reads this every tick, so the switch lands inside the turn
  # that threw it — no restart, and nothing to remember to do afterwards.
  : > "$SOUND_FLAG" || return 1
  print_config
  if ! track_for loop "$SHARE" > /dev/null || ! track_for done "$SHARE" > /dev/null; then
    echo "thinklight: a track is missing; put loop.<ext> and done.<ext> in $SHARE" >&2
  fi
}

mute_sound() {
  rm -f "$SOUND_FLAG" || return 1
  print_config
}

# The daemon only rebuilds its AVAudioPlayers when the sound switch flips, so
# a track swapped in while sound is already on needs a mute/unmute cycle to be
# heard at all — otherwise the change is invisible until the next `unmute`.
reload_sound_if_on() {
  [[ -f "$SOUND_FLAG" ]] || return 0
  mute_sound > /dev/null || return 1
  unmute_sound > /dev/null || return 1
}

# name/author/license/source describe the theme currently in $SHARE, read from
# the theme.json an install left there. No file at all means nothing has ever
# been installed (or `theme reset` put the bundled default back); a file with
# missing or unparseable fields means a theme is installed but did not ship
# metadata — those two are different states and are reported differently.
theme_current() {
  local file="$SHARE/theme.json"
  if [[ ! -f "$file" ]]; then
    echo "name: default"
    return
  fi
  local name title author license source
  name=$(theme_field name "$file")
  title=$(theme_field title "$file")
  author=$(theme_field author "$file")
  license=$(theme_field license "$file")
  source=$(theme_field source "$file")
  echo "name: ${name:-unknown}"
  echo "title: ${title:-unknown}"
  echo "author: ${author:-unknown}"
  echo "license: ${license:-unknown}"
  echo "source: ${source:-unknown}"
}

# A package must offer both tracks, in a format macOS can decode, before
# anything under $SHARE moves — installing half a theme would leave the
# previous one partly overwritten and partly gone.
validate_theme_dir() {
  local dir=$1 loop_track done_track
  loop_track=$(track_for loop "$dir") || {
    echo "thinklight: theme package is missing a loop track (loop.<ext>)" >&2
    return 1
  }
  done_track=$(track_for done "$dir") || {
    echo "thinklight: theme package is missing a done track (done.<ext>)" >&2
    return 1
  }
  ext_allowed "${loop_track##*.}" || {
    echo "thinklight: loop track has an unsupported extension: ${loop_track##*.}" >&2
    return 1
  }
  ext_allowed "${done_track##*.}" || {
    echo "thinklight: done track has an unsupported extension: ${done_track##*.}" >&2
    return 1
  }
}

# Finder's "Compress" on a folder is the ordinary way to hand-build a zip by
# hand, and it wraps the contents in one top-level directory instead of
# zipping them flat — `lofi-rain/loop.mp3` rather than `loop.mp3`. A store
# package is zipped flat and is unaffected. One level of descent, never
# recursive: this command replaces something the user will hear, so which two
# files it picked has to be obvious from the package layout, not searched for.
resolve_theme_root() {
  local dir=$1 entry subdir="" count=0
  track_for loop "$dir" > /dev/null && { printf '%s\n' "$dir"; return 0; }
  for entry in "$dir"/*; do
    [[ -d "$entry" ]] || continue
    # macOS zip drops a __MACOSX sibling with the same tree of resource-fork
    # files; it sits next to the real content directory, not inside it, so it
    # would otherwise look like a second candidate root.
    [[ "${entry##*/}" == "__MACOSX" ]] && continue
    count=$((count + 1))
    subdir=$entry
  done
  if [[ "$count" -eq 1 ]]; then
    printf '%s\n' "$subdir"
  else
    printf '%s\n' "$dir"
  fi
}

theme_install() {
  local input=$1 tmp="" src loop_track done_track staged
  [[ -n "$input" ]] || {
    echo "thinklight: usage: thinklight theme install <package.zip|dir>" >&2
    return 64
  }
  [[ -e "$input" ]] || {
    echo "thinklight: no such file or directory: $input" >&2
    return 65
  }
  if [[ -d "$input" ]]; then
    # Given directly, not descended into: the user pointed at this directory
    # on purpose, so guessing at a subdirectory inside it would be a surprise.
    src=$input
  else
    # unzip and "could not unzip" used to be the same message for "not
    # installed" and "not a zip"; telling them apart tells the user which one
    # to go fix.
    command -v unzip > /dev/null 2>&1 || {
      echo "thinklight: unzip is required to install a zip theme package" >&2
      return 1
    }
    tmp=$(mktemp -d "${TMPDIR:-/tmp}/thinklight-theme.XXXXXX") || {
      echo "thinklight: could not create a temporary directory" >&2
      return 1
    }
    # Cleanup runs when the whole CLI process exits, which is right after this
    # command finishes either way — there is nothing after it in the case.
    trap 'rm -rf "$tmp"' EXIT
    # unzip (Info-ZIP, as shipped on macOS) strips ".." path segments from
    # entry names before extracting, so a crafted entry cannot land outside
    # $tmp; nothing further to guard against a hostile package here.
    unzip -q "$input" -d "$tmp" || {
      echo "thinklight: could not unzip $input — it may not be a valid zip file" >&2
      return 65
    }
    src=$(resolve_theme_root "$tmp")
  fi

  validate_theme_dir "$src" || return 65

  mkdir -p "$SHARE" || {
    echo "thinklight: cannot create the sound directory: $SHARE" >&2
    return 1
  }

  # Assemble the new theme in a staging directory before touching anything
  # installed. Every step below this point can fail — including $src being
  # $SHARE itself, e.g. installing an already-installed theme from where
  # `theme current` says it lives — and until the final mv, the previous
  # theme is untouched. $SHARE/.staged matches neither loop.*/done.* nor the
  # daemon's stem match, so it is invisible to everything else while it
  # exists.
  # Both are silenced so the failure reads as one sentence: mkdir's own
  # "Permission denied" says the same thing a line earlier, in a different
  # voice, and the line that matters is the one naming what ThinkLight was
  # trying to do.
  staged="$SHARE/.staged"
  rm -rf "$staged" 2>/dev/null || {
    echo "thinklight: cannot clear the staging directory: $staged" >&2
    return 1
  }
  mkdir -p "$staged" 2>/dev/null || {
    echo "thinklight: cannot create the staging directory: $staged" >&2
    return 1
  }

  loop_track=$(track_for loop "$src") || {
    rm -rf "$staged"
    echo "thinklight: theme package is missing a loop track (loop.<ext>)" >&2
    return 1
  }
  done_track=$(track_for done "$src") || {
    rm -rf "$staged"
    echo "thinklight: theme package is missing a done track (done.<ext>)" >&2
    return 1
  }
  install -m 644 "$loop_track" "$staged/${loop_track##*/}" || {
    rm -rf "$staged"
    echo "thinklight: could not stage the loop track" >&2
    return 1
  }
  install -m 644 "$done_track" "$staged/${done_track##*/}" || {
    rm -rf "$staged"
    echo "thinklight: could not stage the done track" >&2
    return 1
  }

  # theme.json is metadata, not a track: missing or corrupt, it must not
  # block the install that just staged two perfectly good tracks.
  if [[ -f "$src/theme.json" ]]; then
    cp "$src/theme.json" "$staged/theme.json" || {
      rm -rf "$staged"
      echo "thinklight: could not stage theme metadata" >&2
      return 1
    }
  else
    printf '{}\n' > "$staged/theme.json" || {
      rm -rf "$staged"
      echo "thinklight: could not stage theme metadata" >&2
      return 1
    }
  fi

  # Both tracks and the metadata are on disk under $staged now. From here,
  # $staged is on the same filesystem as $SHARE, so the mv below is a rename
  # per file rather than a copy — there is nothing left that ordinarily
  # fails. Delete before moving in the new tracks: a package that ships
  # loop.mp3 must not land next to a leftover loop.flac, or track_for would
  # keep matching the old file by stem.
  rm -f "$SHARE"/loop.* "$SHARE"/done.* "$SHARE/theme.json" || {
    echo "thinklight: could not remove the previous theme; the new one is staged at $staged — run theme install again" >&2
    return 1
  }
  mv "$staged"/* "$SHARE"/ || {
    echo "thinklight: could not move the new theme into place; $SHARE may be missing tracks — run theme install again" >&2
    return 1
  }
  rm -rf "$staged"

  # A reload failure means the tracks are installed but the daemon has not
  # picked them up yet — a nuisance, not a failed install; the tracks are
  # already on disk by this point.
  reload_sound_if_on \
    || echo "thinklight: theme installed, but could not reload sound; run thinklight mute && thinklight unmute" >&2
  theme_current
}

theme_reset() {
  mkdir -p "$SHARE" || {
    echo "thinklight: cannot create the sound directory: $SHARE" >&2
    return 1
  }
  rm -f "$SHARE"/loop.* "$SHARE"/done.* "$SHARE/theme.json" || {
    echo "thinklight: could not remove the installed theme" >&2
    return 1
  }
  seed_default_tracks || {
    echo "thinklight: could not restore the bundled default tracks" >&2
    return 1
  }
  reload_sound_if_on \
    || echo "thinklight: theme reset, but could not reload sound; run thinklight mute && thinklight unmute" >&2
  theme_current
}

case "${1:-status}" in
  on)
    load_session_context || exit 1
    # Inside an ssh session that carries a tunnel, the light belongs to the
    # machine at the other end of it — the one with a person in front of it.
    # Nothing is recorded here, and no daemon is wanted here either.
    if tunnel_on; then
      schedule_update_check || true
      exit 0
    fi
    # No tunnel, and no camera here to fall back on: an agent on this machine has
    # nowhere to report. That is a machine nobody has set up rather than a
    # failure, and saying so costs a hook error on every single turn.
    [[ "$(uname -s)" == Darwin ]] || exit 0
    if ! write_token; then
      echo "thinklight: could not record the session" >&2
      exit 1
    fi
    if ! ensure_daemon; then
      rm -f "$SESSIONS/$KEY"
      exit 1
    fi
    schedule_update_check || true
    ;;
  off)
    if [[ "${2:-}" == "--force" || -t 0 ]]; then
      # A human typing `off` at a terminal means "light off, now"
      tunnel_clear || true
      clear_sessions || exit 1
      stop_daemons || exit 1
    else
      load_session_context || exit 1
      # Both ends, every time. A turn can begin with a tunnel and end without
      # one, or the reverse, and clearing the side that holds nothing is free.
      tunnel_off || true
      remove_context_tokens || exit 1
    fi
    ;;
  status)
    if daemon_running && has_sessions; then echo on; else echo off; fi
    ;;
  blink)
    "$0" on </dev/null || exit 1
    sleep "${2:-2}" || exit 1
    "$0" off </dev/null
    ;;
  check)
    [[ -x "$BIN_DIR/thinklight-check" ]] || {
      echo "thinklight: reading the camera is a Mac program's job, and this machine has none installed" >&2
      exit 1
    }
    exec "$BIN_DIR/thinklight-check"
    ;;
  version)
    cat "$VERSION_FILE" 2>/dev/null || { echo "unknown"; exit 1; }
    ;;
  config)
    if [[ -n "${2:-}" ]]; then
      set_config "$2" "${3:-}" || exit $?
    else
      print_config
    fi
    ;;
  mute)
    mute_sound || exit 1
    ;;
  unmute)
    unmute_sound || exit 1
    ;;
  theme)
    case "${2:-}" in
      install)
        theme_install "${3:-}" || exit $?
        ;;
      current)
        theme_current
        ;;
      reset)
        theme_reset || exit 1
        ;;
      *)
        echo "thinklight: usage: thinklight theme install <package.zip|dir>|current|reset" >&2
        exit 64
        ;;
    esac
    ;;
  tunnel)
    case "${2:-status}" in
      setup)
        tunnel_setup "${@:3}" || exit $?
        ;;
      status)
        tunnel_status
        ;;
      ensure)
        tunnel_ensure || exit 1
        ;;
      *)
        echo "thinklight: usage: thinklight tunnel setup [host ...]|status" >&2
        exit 64
        ;;
    esac
    ;;
  update)
    if [[ "${2:-}" == "--check" ]]; then check_update; else perform_update; fi
    ;;
  _check_update_notify)
    if installed_from_source; then
      installed=$(cat "$REVISION_FILE" 2>/dev/null)
      remote=$(remote_revision)
      [[ -n "$remote" && "$installed" != "$remote" ]] || exit 0
      detail="Run thinklight update to install it."
    else
      read -r state installed remote <<< "$(release_status)"
      [[ "$state" == behind ]] || exit 0
      detail="Run thinklight update to install $remote."
    fi
    # Integration tests read the notice instead of watching for a banner. Printing
    # is safe here where _version_notify cannot risk it: this runs detached from
    # any hook, so its stdout goes nowhere near Claude's context.
    [[ "${THINKLIGHT_TEST_NO_NOTIFY:-}" == "1" ]] && { printf '%s\n' "$detail"; exit 0; }
    notify "ThinkLight update available" "$detail"
    ;;
  _version_notify)
    # The Claude Code plugin updates itself; the binaries in ~/.local/bin do
    # not. Left alone the two drift into a combination nobody chose — new hooks
    # calling an old CLI — and the user has no way to see it, because the drift
    # arrived through an update they never ran. The plugin normally closes that
    # gap by installing the programs itself; this is what it falls back to when
    # it must not — a source checkout owns the install, bootstrap is off, or the
    # download failed — so the gap is at least visible.
    #
    # Notified rather than printed: SessionStart stdout becomes Claude's
    # context, and a maintenance notice does not belong there. Once per version,
    # not once per session — a notice you cannot act on twice is nagging.
    plugin_version="${2:-}"
    installed=$(cat "$VERSION_FILE" 2>/dev/null)
    [[ -n "$plugin_version" && -n "$installed" ]] || exit 0
    # Claude and Codex can update the same plugin at different times while
    # sharing this one program install. A lagging plugin is already served by
    # newer programs; calling that state out of date would be both false and,
    # with an older bootstrap hook, part of an upgrade/downgrade loop.
    version_at_least "$installed" "$plugin_version" && exit 0
    [[ "$(cat "$VERSION_NOTICE_FILE" 2>/dev/null)" != "$plugin_version" ]] || exit 0
    mkdir -p "$STATE" || exit 0
    printf '%s\n' "$plugin_version" > "$VERSION_NOTICE_FILE"
    # `thinklight update` is the answer for either install, so the only case that
    # needs its own advice is bootstrap being switched off on a prebuilt install:
    # switching it back on is less work than updating by hand every release.
    if [[ -f "$BOOTSTRAP_OFF" ]] && [[ ! -f "$SOURCE_FILE" ]]; then
      how="Run thinklight config bootstrap on to let the plugin catch them up."
    else
      how="Run thinklight update to catch up."
    fi
    # Integration tests exercise the drift bookkeeping without popping banners.
    [[ "${THINKLIGHT_TEST_NO_NOTIFY:-}" == "1" ]] && exit 0
    notify "ThinkLight is out of date" \
      "Programs are at $installed, plugin at $plugin_version. $how"
    ;;
  _sync)
    # Internal upgrade hook: replace any older daemon, then let session tokens decide.
    mkdir -p "$SESSIONS" || exit 1
    stop_daemons || exit 1
    if has_sessions; then ensure_daemon; fi
    ;;
  *)
    echo "usage: thinklight on|off [--force]|status|blink [seconds]|check|config [key value]|mute|unmute|theme install <pkg>|current|reset|tunnel setup|status|version|update [--check]" >&2
    exit 64
    ;;
esac
